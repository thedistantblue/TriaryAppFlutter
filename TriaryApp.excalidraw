    },
    {
      "type": "text",
      "version": 1081,
      "versionNonce": 1535886745,
      "isDeleted": false,
      "id": "qgh4e8KZ",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "angle": 0,
      "x": 130.28758154123983,
      "y": 2782.4311876784327,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "width": 463.7197265625,
      "height": 125,
      "seed": 672251106,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790110067519,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Удаление набора упражнений должно проверять\nреальные инстансы тренировок, в которых он\nзадействован, и если он задействован\nхотя бы в одной тренировке, то\nтакой набор должно быть нельзя удалить",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Удаление набора упражнений должно проверять\nреальные инстансы тренировок, в которых он\nзадействован, и если он задействован\nхотя бы в одной тренировке, то\nтакой набор должно быть нельзя удалить",
      "lineHeight": 1.25,
      "index": "b2i",
      "created": null,
      "autoResize": true,
      "labelPosition": null,
      "baseFontSize": null
    },
