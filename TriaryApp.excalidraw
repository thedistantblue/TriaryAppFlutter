      "width": 1095.439453125,
      "height": 325,
      "seed": 613605783,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "a7ei6SZ9uMSlQKLTSC8h-",
